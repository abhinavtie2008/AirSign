{
  "manifest_version": 3,
  "short_name": "AirSign",
  "homepage_url": "https://abhinavtie2008.github.io/AirSign/",
  "name": "AirSign — Touchless Browsing",
  "version": "2.3.1",
  "description": "Control webpages with hand gestures from your webcam. Hand tracking runs locally in the side panel or a draggable camera bubble.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AirSign",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "bubble.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
